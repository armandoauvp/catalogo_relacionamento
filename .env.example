# ---------------------------------------------------------------------------
# Banco de dados (Postgres)
# Local: docker compose up -d  →  a string abaixo já aponta para o container.
# Railway: o valor vem da variável do serviço Postgres do projeto.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://catalogo:catalogo@localhost:5432/catalogo_presentes?schema=public"

# ---------------------------------------------------------------------------
# NextAuth / SSO AUVP (OIDC)
# AUTH_SECRET: gere com `npx auth secret` ou `openssl rand -base64 32`.
# AUTH_OIDC_ISSUER: URL do issuer OIDC (o /.well-known/openid-configuration
#   é resolvido a partir dela).
# O provedor é o Keycloak da AUVP. O issuer é o do realm, não a raiz:
#   https://sso.auvp.com.br/realms/master. Ver docs/05-perguntas-em-aberto.md.
# ---------------------------------------------------------------------------
# Em produção: AUTH_URL="https://catalogo-relacionamento.prod.auvp.net".
# Configuração do client no Keycloak: docs/10-entrega-ti.md.
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
AUTH_OIDC_ISSUER="https://sso.auvp.com.br/realms/master"
AUTH_OIDC_CLIENT_ID="catalogo_relacionamento"
# Sem o secret o botão do SSO não aparece e o login local segue pelo bypass.
AUTH_OIDC_CLIENT_SECRET=""
# Nome exibido no botão de login.
AUTH_OIDC_NAME="AUVP SSO"
# Claim opcional que carrega grupos/departamento no token do provedor.
# Se o SSO devolver grupos, preencher para mapear perfil automaticamente.
AUTH_OIDC_GROUPS_CLAIM=""

# Login com o Google da AUVP. Basta ele, ou o Keycloak acima, para a produção
# subir; os dois juntos aparecem lado a lado. O client OAuth é criado no Google
# Cloud, ver docs/12-producao-vercel.md, passo 2.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Domínios de e-mail que podem entrar, separados por vírgula (ex. auvp.com.br).
# Obrigatório em produção: é o que barra uma conta de fora se o client OIDC
# tiver sido criado aberto no provedor. Vazio libera tudo, só em desenvolvimento.
AUTH_ALLOWED_EMAIL_DOMAINS=""

# E-mails que recebem perfil admin no primeiro login (separados por vírgula).
# Necessário para destravar o bootstrap: sem isso o primeiro usuário entra como
# consultor e ninguém consegue promover ninguém.
BOOTSTRAP_ADMIN_EMAILS=""

# Em desenvolvimento, permite entrar sem SSO configurado com um usuário fake.
# NUNCA habilitar em produção — o código recusa a flag fora de NODE_ENV=development.
AUTH_DEV_BYPASS="false"

# Aplicação real com dados fictícios e login por perfil, sem SSO. Só liga na
# Vercel, e nunca junto de um login de verdade; fora disso o boot recusa.
# Ver docs/12-producao-vercel.md.
MODO_DEMONSTRACAO="false"

# Fase de testes: quem entra escolhe, no menu da conta, o perfil com que vê a
# ferramenta (Admin, Consultor, Financeiro, Logística). Não muda o cadastro;
# apagar a variável devolve cada um ao próprio perfil. Ver
# docs/12-producao-vercel.md.
PERFIL_LIVRE="false"

# ---------------------------------------------------------------------------
# Storage das fotos de produto (bucket S3-compatível)
# ---------------------------------------------------------------------------
STORAGE_ENDPOINT=""
STORAGE_REGION="us-east-1"
STORAGE_BUCKET="catalogo-presentes"
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
# Host público das imagens, usado no next.config.ts (sem protocolo).
NEXT_PUBLIC_STORAGE_HOSTNAME=""

# ---------------------------------------------------------------------------
# Provedores de dados (camada trocável — ver src/lib/providers)
# local     → catálogo e clientes no próprio Postgres (V1)
# tiny      → catálogo vindo do Tiny ERP (fase 2)
# salesforce→ clientes vindos do Salesforce (fase 2)
# ---------------------------------------------------------------------------
CATALOG_PROVIDER="local"
CLIENT_PROVIDER="local"

# ---------------------------------------------------------------------------
# Fase 2 — credenciais reservadas, vazias no V1
# ---------------------------------------------------------------------------
# Tiny (Olist ERP): com o token, presentes aprovados e lotes importados viram
# pedidos lá, pela fila. Sem ele, nada entra na fila. Ver docs/13-tiny.md.
TINY_API_TOKEN=""
TINY_API_BASE_URL="https://api.tiny.com.br/api2"
# Segredo que o agendador manda para esvaziar a fila (/api/tiny/cron). Gere com
# `openssl rand -base64 32`; o mesmo valor vai no secret do GitHub Actions.
CRON_SECRET=""
SALESFORCE_INSTANCE_URL=""
SALESFORCE_CLIENT_ID=""
SALESFORCE_CLIENT_SECRET=""

# ---------------------------------------------------------------------------
# Integrações auxiliares
# ---------------------------------------------------------------------------
VIACEP_BASE_URL="https://viacep.com.br/ws"
