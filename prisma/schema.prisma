// Catálogo e Solicitação de Presentes, schema V1.
//
// Duas regras atravessam o arquivo inteiro:
//
// 1. Nada é deletado. Produto, categoria e usuário são desativados via `ativo`,
//    porque solicitações antigas precisam continuar legíveis exatamente como
//    foram criadas.
// 2. Os campos das integrações de fase 2 (`sku_tiny`, `tiny_*`, `rastreio`,
//    `salesforce_id`) já existem aqui, nulos no V1. Ligar Tiny e Salesforce
//    depois não deve exigir migração de dados nem mudança de tela.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Perfil {
  consultor
  admin
  financeiro
  /// Time de Logística: opera a expedição e mantém o Dashboard Logístico.
  /// Não cria nem acompanha solicitação de presente. Ver ADR 0008.
  logistica
}

/// De onde o presente sai quando alguém pede.
///
/// É a coluna "Estoque" da planilha do catálogo, e é ela que decide se a
/// solicitação passa pelo Financeiro, não a quantidade em estoque, que a área
/// não mantém produto a produto.
enum OrigemProduto {
  /// Já está na prateleira. Aprovada, a solicitação vai direto para a expedição.
  estoque_interno
  /// Comprado quando alguém pede. Passa pelo Financeiro.
  mediante_pedido
}

enum TipoValor {
  exato
  medio
}

enum OrigemCliente {
  manual
  importacao
  salesforce
}

enum MotivoEnvio {
  aniversario
  casamento
  nascimento
  reforco_relacionamento
  primeiro_milhao
  outro
}

/// Os nove status do fluxo da spec, mais `cancelado`.
///
/// `cancelado` não está na lista dos nove, mas é exigido por duas regras do
/// documento: "de Deu problema a solicitação pode voltar para qualquer status
/// anterior ou ser cancelada" e "o saldo considera todos os status exceto os
/// cancelados e devolvidos". Sem ele não há como representar nenhuma das duas.
enum StatusSolicitacao {
  pendente
  aguardando_aprovacao
  aguardando_compra
  comprado
  organizando_envio
  entregue
  cliente_confirmou
  deu_problema
  devolvido
  cancelado
}

// ---------------------------------------------------------------------------
// Usuários
// ---------------------------------------------------------------------------

/// Espelho local da identidade do SSO. Perfil e limite mensal moram aqui, e não
/// no provedor de identidade, para que Relacionamento ajuste sem passar por TI.
model Usuario {
  id           String   @id @default(cuid())
  nome         String
  email        String   @unique
  /// `sub` do token OIDC. Guardado para reconhecer o usuário mesmo que o
  /// e-mail mude no provedor de identidade.
  ssoSubject   String?  @unique @map("sso_subject")
  perfil       Perfil   @default(consultor)
  /// Teto de gasto mensal em BRL. Nulo = sem limite definido.
  /// No V1 estourar o limite apenas sinaliza; bloqueio depende de decisão da área.
  limiteMensal Decimal? @map("limite_mensal") @db.Decimal(12, 2)
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  solicitacoes    Solicitacao[]             @relation("SolicitacoesDoConsultor")
  historicos      SolicitacaoHistorico[]
  clientesCriados Cliente[]                 @relation("ClientesCriadosPor")
  statusDefinidos StatusOperacionalSemana[]
  lotesTiny       LoteTiny[]

  @@index([perfil, ativo])
  @@map("usuarios")
}

// ---------------------------------------------------------------------------
// Catálogo
// ---------------------------------------------------------------------------

model Categoria {
  id       String   @id @default(cuid())
  nome     String   @unique
  ativo    Boolean  @default(true)
  criadoEm DateTime @default(now()) @map("criado_em")

  produtos Produto[]

  @@index([ativo])
  @@map("categorias")
}

model Produto {
  id                      String        @id @default(cuid())
  nome                    String
  descricao               String?
  categoriaId             String        @map("categoria_id")
  fotoUrl                 String?       @map("foto_url")
  /// Nulo quando a área ainda não informou o preço, o caso dos brindes
  /// personalizados comprados em lote. Nulo não é zero: a tela diz "a definir"
  /// em vez de exibir R$ 0,00, que se leria como grátis.
  valor                   Decimal?      @db.Decimal(12, 2)
  /// `exato` = preço fechado. `medio` = estimativa, exibida como "a partir de".
  tipoValor               TipoValor     @default(exato) @map("tipo_valor")
  /// Prateleira ou compra sob demanda. Decide se a solicitação passa pelo
  /// Financeiro. Ver `precisaDeCompra` em `src/lib/status.ts`.
  origem                  OrigemProduto @default(mediante_pedido)
  /// Refinamento opcional de `origem = estoque_interno`: quando a área
  /// resolver contar as peças, um saldo insuficiente manda ao Financeiro
  /// mesmo sendo item de prateleira.
  controlaEstoque         Boolean       @default(false) @map("controla_estoque")
  estoque                 Int?
  /// Onde o Financeiro compra este produto. É a coluna "Link" da planilha,
  /// e vence o fornecedor padrão da categoria.
  urlCompra               String?       @map("url_compra")
  /// Instrução de compra que não é um link, "Pedido direto ao fornecedor".
  /// Pode conviver com `urlCompra`: há kit em que parte vem de cada lugar.
  notaDeCompra            String?       @map("nota_de_compra")
  /// O que este produto precisa levar junto para poder ser enviado, por
  /// exemplo `vinho`. A caixa de madeira e o kit de queijos não fazem sentido
  /// sozinhos: chegariam ao cliente sem a bebida que os acompanha.
  ///
  /// A solicitação só é aceita quando traz também um item cujo
  /// `serveComoAcompanhamento` é este mesmo rótulo. Ver
  /// `src/lib/acompanhamentos.ts`.
  exigeAcompanhamento     String?       @map("exige_acompanhamento")
  /// O que este produto satisfaz quando entra na mesma solicitação, por
  /// exemplo `vinho` nas garrafas de vinho.
  serveComoAcompanhamento String?       @map("serve_como_acompanhamento")
  ativo                   Boolean       @default(true)
  /// Fase 2: SKU correspondente no Tiny ERP.
  skuTiny                 String?       @map("sku_tiny")
  criadoEm                DateTime      @default(now()) @map("criado_em")
  atualizadoEm            DateTime      @updatedAt @map("atualizado_em")

  categoria Categoria         @relation(fields: [categoriaId], references: [id], onDelete: Restrict)
  itens     SolicitacaoItem[]

  @@index([ativo, categoriaId])
  @@index([nome])
  @@map("produtos")
}

// ---------------------------------------------------------------------------
// Clientes
// ---------------------------------------------------------------------------

/// CPF é a chave de deduplicação: armazenado apenas com dígitos, sem máscara,
/// para que a busca não dependa de formatação.
model Cliente {
  id           String        @id @default(cuid())
  nome         String
  cpf          String        @unique
  telefone     String?
  email        String?
  /// Fase 2: id do registro correspondente no Salesforce.
  salesforceId String?       @unique @map("salesforce_id")
  origem       OrigemCliente @default(manual)
  criadoPor    String?       @map("criado_por")
  criadoEm     DateTime      @default(now()) @map("criado_em")
  atualizadoEm DateTime      @updatedAt @map("atualizado_em")

  criador      Usuario?      @relation("ClientesCriadosPor", fields: [criadoPor], references: [id], onDelete: SetNull)
  solicitacoes Solicitacao[]

  @@index([nome])
  @@map("clientes")
}

// ---------------------------------------------------------------------------
// Solicitações
// ---------------------------------------------------------------------------

model Solicitacao {
  id          String @id @default(cuid())
  /// Código sequencial legível por ano: SOL-2026-0001. Ver src/lib/codigo.ts.
  codigo      String @unique
  consultorId String @map("consultor_id")
  clienteId   String @map("cliente_id")

  motivo        MotivoEnvio
  /// Obrigatório quando `motivo = outro`; validado na camada de aplicação.
  motivoOutro   String?     @map("motivo_outro")
  mensagemCarta String      @map("mensagem_carta")
  observacoes   String?

  status     StatusSolicitacao @default(pendente)
  /// Soma congelada dos itens. Recalculada em toda escrita de item, dentro da
  /// mesma transação, para que relatório e saldo não dependam de join.
  valorTotal Decimal           @default(0) @map("valor_total") @db.Decimal(12, 2)

  // Endereço gravado como snapshot: se o cliente se mudar, a solicitação antiga
  // continua mostrando para onde o presente foi de fato enviado.
  entregaCep          String  @map("entrega_cep")
  entregaLogradouro   String  @map("entrega_logradouro")
  entregaNumero       String  @map("entrega_numero")
  entregaComplemento  String? @map("entrega_complemento")
  entregaBairro       String  @map("entrega_bairro")
  entregaCidade       String  @map("entrega_cidade")
  entregaUf           String  @map("entrega_uf") @db.Char(2)
  entregaDestinatario String  @map("entrega_destinatario")

  // Fase 2: nulos no V1.
  tinyPedidoId   String? @map("tiny_pedido_id")
  tinyStatus     String? @map("tiny_status")
  rastreio       String?
  transportadora String?

  dataSolicitacao DateTime @default(now()) @map("data_solicitacao")
  atualizadoEm    DateTime @updatedAt @map("atualizado_em")

  consultor  Usuario                @relation("SolicitacoesDoConsultor", fields: [consultorId], references: [id], onDelete: Restrict)
  cliente    Cliente                @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  itens      SolicitacaoItem[]
  historico  SolicitacaoHistorico[]
  /// A demanda que a aprovação abriu na trilha da Logística.
  demanda    DemandaLogistica?
  /// O pedido que a aprovação abriu no Tiny, quando a integração está ligada.
  pedidoTiny PedidoTiny?

  @@index([consultorId, dataSolicitacao])
  @@index([status])
  @@index([clienteId])
  @@index([dataSolicitacao])
  @@map("solicitacoes")
}

/// Ou o item vem do catálogo (`produtoId`), ou é um presente específico
/// (`descricaoLivre` + `urlExterna`). A exclusividade é garantida por CHECK
/// constraint na migration e revalidada na camada de aplicação.
///
/// `valorUnitario` é sempre congelado no momento da criação: item de catálogo
/// copia o valor do produto, item específico usa o valor digitado. Alterar o
/// preço do produto depois não mexe em solicitação já feita.
model SolicitacaoItem {
  id             String   @id @default(cuid())
  solicitacaoId  String   @map("solicitacao_id")
  produtoId      String?  @map("produto_id")
  descricaoLivre String?  @map("descricao_livre")
  urlExterna     String?  @map("url_externa")
  valorUnitario  Decimal  @map("valor_unitario") @db.Decimal(12, 2)
  quantidade     Int      @default(1)
  criadoEm       DateTime @default(now()) @map("criado_em")

  solicitacao Solicitacao @relation(fields: [solicitacaoId], references: [id], onDelete: Cascade)
  produto     Produto?    @relation(fields: [produtoId], references: [id], onDelete: Restrict)

  @@index([solicitacaoId])
  @@index([produtoId])
  @@map("solicitacao_itens")
}

/// Uma linha por mudança de status. É o que sustenta a auditoria e responde
/// "por que essa solicitação parou". Nunca é editado nem apagado.
model SolicitacaoHistorico {
  id             String             @id @default(cuid())
  solicitacaoId  String             @map("solicitacao_id")
  statusAnterior StatusSolicitacao? @map("status_anterior")
  statusNovo     StatusSolicitacao  @map("status_novo")
  usuarioId      String?            @map("usuario_id")
  /// Obrigatório em `deu_problema` e `devolvido`.
  motivo         String?
  criadoEm       DateTime           @default(now()) @map("criado_em")

  solicitacao Solicitacao @relation(fields: [solicitacaoId], references: [id], onDelete: Cascade)
  usuario     Usuario?    @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([solicitacaoId, criadoEm])
  @@map("solicitacao_historico")
}

/// Contador do código sequencial por ano. Uma linha por ano, incrementada
/// dentro da transação que cria a solicitação.
model ContadorCodigo {
  ano   Int @id
  valor Int @default(0)

  @@map("contador_codigo")
}

// ---------------------------------------------------------------------------
// Arquivos
// ---------------------------------------------------------------------------

/// Foto de produto guardada no próprio banco.
///
/// A spec previa um bucket S3-compatível, e o `env` já reserva as variáveis.
/// No V1 o arquivo fica aqui por uma razão prática: são algumas dezenas de
/// fotos de catálogo, e depender de bucket provisionado atrasaria a única
/// coisa que a área precisa fazer sozinha, cadastrar produto com foto.
///
/// A troca por bucket mexe em um lugar só: `src/lib/arquivos.ts`. `fotoUrl`
/// continua sendo uma URL, e as telas não sabem de onde ela vem.
model Arquivo {
  id        String   @id @default(cuid())
  nome      String
  /// MIME type. Validado na aplicação contra a lista de imagens aceitas.
  tipo      String
  /// Em bytes. Redundante com `length(dados)`, mas evita ler o binário só
  /// para listar tamanho.
  tamanho   Int
  dados     Bytes
  criadoPor String?  @map("criado_por")
  criadoEm  DateTime @default(now()) @map("criado_em")

  @@map("arquivos")
}

// ---------------------------------------------------------------------------
// Logística (ADR 0008)
// ---------------------------------------------------------------------------

/// As fases operacionais padronizadas da proposta da Logística, na ordem em
/// que uma demanda anda. É o "status" que a trilha mostra.
enum FaseOperacional {
  recebido
  em_analise
  aguardando_documentacao
  aguardando_suprimentos
  em_execucao
  revisao
  finalizacao
  concluido
}

/// As quatro prioridades do ClickUp, para casar sem tradução.
enum PrioridadeDemanda {
  urgente
  alta
  normal
  baixa
}

enum ComplexidadeDemanda {
  baixa
  media
  alta
}

/// Status geral da operação na semana, como a proposta pede.
enum SituacaoOperacional {
  normal
  alto_volume
  risco_de_atraso
  critica
}

/// De onde a demanda veio. `manual` é o cadastro da Logística na trilha, o
/// caso comum; `solicitacao`, o presente aprovado, que entra sozinho. Sobra
/// `clickup` das demandas anteriores à trilha manual.
enum OrigemDemanda {
  manual
  clickup
  solicitacao
}

/// De quanto em quanto tempo uma demanda recorrente volta.
enum Periodicidade {
  semanal
  quinzenal
  mensal
}

/// Uma demanda da Logística: o envio que o dashboard conta e a trilha lista.
///
/// Cadastrada à mão pela Logística, na própria trilha. A tarefa no ClickUp,
/// quando existe, é só um link: a trilha não espelha o ClickUp. Ver
/// docs/11-logistica.md.
///
/// Departamento, subsidiária e produto ficam como texto, com sugestão dos
/// valores já usados: uma tabela de cadastro aqui seria um segundo lugar para
/// manter uma lista que a área ainda está definindo.
model DemandaLogistica {
  id                   String               @id @default(cuid())
  origem               OrigemDemanda        @default(manual)
  /// Sobra das demandas anteriores à trilha manual.
  clickupId            String?              @unique @map("clickup_id")
  /// Link para a tarefa no ClickUp, quando ela existe.
  clickupUrl           String?              @map("clickup_url")
  titulo               String
  subsidiaria          String?
  departamento         String?
  produto              String?
  /// O que está sendo enviado. Mais de um item vira "Kit" na tela.
  itens                String[]             @default([])
  fase                 FaseOperacional      @default(recebido)
  prioridade           PrioridadeDemanda    @default(normal)
  complexidade         ComplexidadeDemanda?
  responsavel          String?
  /// Texto livre, onde costuma aparecer nome e endereço de quem recebe.
  /// Lido só por quem tem `logistica.verObservacoes`.
  observacoes          String?
  linkFormulario       String?              @map("link_formulario")
  /// Quanto custou mandar, em BRL. Fora de uso desde 22/10/2026: a área tirou
  /// o custo da ferramenta. A coluna fica para não perder o que foi anotado.
  custoEnvio           Decimal?             @map("custo_envio") @db.Decimal(12, 2)
  /// Volta sozinha: ao concluir, nasce a próxima ocorrência.
  recorrente           Boolean              @default(false)
  periodicidade        Periodicidade?
  /// A ocorrência de onde esta nasceu. Única: uma recorrente concluída gera
  /// uma próxima, nunca duas, mesmo que a conclusão seja salva de novo.
  ocorrenciaAnteriorId String?              @unique @map("ocorrencia_anterior_id")
  /// O presente aprovado que virou esta demanda (ADR 0009).
  solicitacaoId        String?              @unique @map("solicitacao_id")
  /// Arquivada some do dashboard sem ser apagada: é o caminho para o que foi
  /// cadastrado por engano e para o presente cancelado.
  ativa                Boolean              @default(true)
  solicitadaEm         DateTime             @map("solicitada_em")
  previsaoInicio       DateTime?            @map("previsao_inicio")
  /// Obrigatória no cadastro. Nula só nas demandas antigas, e a trilha aponta
  /// a falta em vez de esconder.
  previsaoConclusao    DateTime?            @map("previsao_conclusao")
  concluidaEm          DateTime?            @map("concluida_em")
  sincronizadaEm       DateTime?            @map("sincronizada_em")
  criadoEm             DateTime             @default(now()) @map("criado_em")
  atualizadoEm         DateTime             @updatedAt @map("atualizado_em")

  ocorrenciaAnterior DemandaLogistica? @relation("Recorrencia", fields: [ocorrenciaAnteriorId], references: [id], onDelete: SetNull)
  proximaOcorrencia  DemandaLogistica? @relation("Recorrencia")
  solicitacao        Solicitacao?      @relation(fields: [solicitacaoId], references: [id], onDelete: Restrict)
  /// O lote de envio que esta demanda representa na trilha.
  loteTiny           LoteTiny?

  @@index([solicitadaEm])
  @@index([concluidaEm])
  @@index([previsaoConclusao])
  @@index([ativa])
  @@map("demandas_logistica")
}

/// O status da semana definido à mão pela Logística.
///
/// Sem linha, ou com `situacao` nula, vale o automático calculado em
/// `src/lib/logistica/status-operacional.ts`. Voltar ao automático anula a
/// situação em vez de apagar a linha: quem definiu e quando continuam lá.
model StatusOperacionalSemana {
  id            String               @id @default(cuid())
  ano           Int
  semana        Int
  situacao      SituacaoOperacional?
  observacao    String?
  definidoPorId String?              @map("definido_por_id")
  definidoEm    DateTime             @default(now()) @map("definido_em")

  definidoPor Usuario? @relation(fields: [definidoPorId], references: [id], onDelete: SetNull)

  @@unique([ano, semana])
  @@map("status_operacional_semana")
}

/// Quem compõe o time de Logística, para a seção "Equipe".
model MembroEquipe {
  id        String   @id @default(cuid())
  nome      String
  funcao    String
  descricao String?
  email     String?
  fotoUrl   String?  @map("foto_url")
  ordem     Int      @default(0)
  ativo     Boolean  @default(true)
  criadoEm  DateTime @default(now()) @map("criado_em")

  @@index([ativo, ordem])
  @@map("membros_equipe")
}

/// Pergunta frequente. O conteúdo está em elaboração pela Logística.
model PerguntaFrequente {
  id       String   @id @default(cuid())
  pergunta String
  resposta String
  ordem    Int      @default(0)
  ativo    Boolean  @default(true)
  criadoEm DateTime @default(now()) @map("criado_em")

  @@index([ativo, ordem])
  @@map("perguntas_frequentes")
}

// ---------------------------------------------------------------------------
// Tiny ERP
// ---------------------------------------------------------------------------

/// De onde veio o pedido que vai ao Tiny.
enum OrigemPedidoTiny {
  /// Presente aprovado que chegou a "Organizando envio".
  solicitacao
  /// Linha de uma planilha importada em lote.
  lote
}

/// Andamento do envio do pedido ao Tiny. A situação dentro do Tiny (aberto,
/// faturado, entregue...) é outra coisa, e fica em `PedidoTiny.situacao`.
enum EnvioTiny {
  pendente
  processando
  enviado
  falhou
}

/// Um pedido que esta ferramenta manda ao Tiny, e a fila que o leva até lá.
///
/// A fila mora no banco e é gravada na mesma transação que a originou
/// (ADR 0009): a aprovação não espera o Tiny, e nada se perde se ele estiver
/// fora. O token nunca é guardado aqui, só o pedido.
model PedidoTiny {
  id                 String           @id @default(cuid())
  origem             OrigemPedidoTiny
  /// Idempotência. Um presente gera um pedido só, e a mesma pessoa não
  /// recebe duas vezes o mesmo item de um marcador, mesmo que a planilha seja
  /// importada de novo.
  chave              String           @unique
  solicitacaoId      String?          @unique @map("solicitacao_id")
  loteId             String?          @map("lote_id")
  /// Linha da planilha, para quem confere o lote achar o erro no arquivo.
  linha              Int?
  destinatario       String
  cpfCnpj            String           @map("cpf_cnpj")
  /// O que vai, em uma linha: "2× Livro AUVP".
  resumo             String
  /// O pedido como é enviado ao Tiny, para reenviar igual.
  payload            Json
  envio              EnvioTiny        @default(pendente)
  tentativas         Int              @default(0)
  proximaTentativaEm DateTime         @default(now()) @map("proxima_tentativa_em")
  erro               String?
  tinyId             String?          @map("tiny_id")
  tinyNumero         String?          @map("tiny_numero")
  /// Situação do pedido dentro do Tiny, trazida pela sincronização.
  situacao           String?
  rastreio           String?
  urlRastreio        String?          @map("url_rastreio")
  notaFiscalId       String?          @map("nota_fiscal_id")
  enviadoEm          DateTime?        @map("enviado_em")
  sincronizadoEm     DateTime?        @map("sincronizado_em")
  criadoEm           DateTime         @default(now()) @map("criado_em")
  atualizadoEm       DateTime         @updatedAt @map("atualizado_em")

  solicitacao Solicitacao? @relation(fields: [solicitacaoId], references: [id], onDelete: Restrict)
  lote        LoteTiny?    @relation(fields: [loteId], references: [id], onDelete: Restrict)
  eventos     EventoTiny[]

  @@index([envio, proximaTentativaEm])
  @@index([loteId])
  @@index([criadoEm])
  @@map("pedidos_tiny")
}

/// Uma planilha importada: um produto, uma transportadora e um marcador para
/// todas as linhas, como no AUVP-Eventos.
model LoteTiny {
  id             String   @id @default(cuid())
  marcador       String
  arquivo        String?
  sku            String?
  produto        String
  valorUnitario  Decimal  @map("valor_unitario") @db.Decimal(12, 2)
  transportadora String?
  formaFrete     String?  @map("forma_frete")
  subsidiaria    String?
  departamento   String?
  criadoPorId    String?  @map("criado_por_id")
  /// A demanda que o lote abriu na trilha da Logística.
  demandaId      String?  @unique @map("demanda_id")
  criadoEm       DateTime @default(now()) @map("criado_em")

  criadoPor Usuario?          @relation(fields: [criadoPorId], references: [id], onDelete: SetNull)
  demanda   DemandaLogistica? @relation(fields: [demandaId], references: [id], onDelete: SetNull)
  pedidos   PedidoTiny[]

  @@index([criadoEm])
  @@map("lotes_tiny")
}

/// O que aconteceu com cada pedido: enviado, recusado, rastreio novo. É o
/// histórico que a tela do Tiny mostra, e nunca é editado.
model EventoTiny {
  id       String   @id @default(cuid())
  pedidoId String?  @map("pedido_id")
  tipo     String
  mensagem String
  criadoEm DateTime @default(now()) @map("criado_em")

  pedido PedidoTiny? @relation(fields: [pedidoId], references: [id], onDelete: SetNull)

  @@index([criadoEm])
  @@map("eventos_tiny")
}

/// O padrão dos pedidos de presente no Tiny. Uma linha só, editada na tela do
/// Tiny pela Logística.
model ConfiguracaoTiny {
  id                String   @id @default("unica")
  /// Presente aprovado vira pedido no Tiny sozinho.
  enviarPresentes   Boolean  @default(true) @map("enviar_presentes")
  transportadora    String?
  formaFrete        String?  @map("forma_frete")
  marcadorPresentes String   @default("Presente Relacionamento") @map("marcador_presentes")
  atualizadoEm      DateTime @updatedAt @map("atualizado_em")

  @@map("configuracao_tiny")
}
